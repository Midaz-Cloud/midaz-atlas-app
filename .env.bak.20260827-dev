# Dev local. El network_security_config del APK solo permite cleartext a loopback,
# asi que la API va por adb reverse tcp:3000 (no por la IP LAN).
# Rebuild nativo tras cambiar valores (react-native-config hornea en build time).

KIOSK_DEMO_MODE=false

KIOSK_API_USE_MOCK=false
KIOSK_API_BASE_URL=http://localhost:3000
KIOSK_UPLOADS_BASE_URL=http://localhost:3000
KIOSK_API_KEY=069b72104fb86349d77f18da7aa39513e5f8ac9f

# Serial real del AF910S registrado en midaz_organizations.kiosk_devices.
# KIOSK_DEVICE_SERIAL_OVERRIDE=AF910S20250915040

# HkaApp (com.thefactory.demoPP9) en el mismo equipo
KIOSK_FISCAL_SERVICE_URL=http://127.0.0.1:8765
# KIOSK_FISCAL_MOCK=true

# Abre el panel de administración del kiosko (5 toques en el logo).
KIOSK_ADMIN_PASSCODE=650645
