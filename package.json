{
  "name": "MidazAtlasApp",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "android": "node scripts/adbDevServer.js && cross-env STORYBOOK_ENABLED=false ANDROID_HOME=%LOCALAPPDATA%/Android/Sdk ANDROID_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk react-native run-android",
    "android:install": "node scripts/adbDevServer.js && cross-env STORYBOOK_ENABLED=false ANDROID_HOME=%LOCALAPPDATA%/Android/Sdk ANDROID_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk react-native run-android --no-packager",
    "android:demo": "node scripts/adbDevServer.js && cross-env STORYBOOK_ENABLED=false ENVFILE=.env.demo ANDROID_HOME=%LOCALAPPDATA%/Android/Sdk ANDROID_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk react-native run-android",
    "android:demo:install": "node scripts/adbDevServer.js && cross-env STORYBOOK_ENABLED=false ENVFILE=.env.demo ANDROID_HOME=%LOCALAPPDATA%/Android/Sdk ANDROID_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk react-native run-android --no-packager",
    "android:release": "npm run android:release:apk && npm run android:release:install",
    "android:release:apk": "cross-env STORYBOOK_ENABLED=false node scripts/assembleAndroidRelease.js",
    "android:release:install": "node scripts/installAndroidReleaseApk.js",
    "android:release:run": "cross-env STORYBOOK_ENABLED=false ANDROID_HOME=%LOCALAPPDATA%/Android/Sdk ANDROID_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk react-native run-android --mode release --no-packager",
    "android:demo:release": "cross-env STORYBOOK_ENABLED=false ENVFILE=.env.demo node scripts/assembleAndroidRelease.js",
    "ios": "cross-env STORYBOOK_ENABLED=false react-native run-ios",
    "ios:demo": "cross-env STORYBOOK_ENABLED=false ENVFILE=.env.demo react-native run-ios",
    "start:demo": "cross-env STORYBOOK_ENABLED=false ENVFILE=.env.demo node scripts/startMetro.js",
    "lint": "eslint .",
    "start": "node scripts/startMetro.js",
    "metro:host": "node scripts/getLanHost.js",
    "storybook:stop": "npx --yes kill-port 8081 7007",
    "storybook": "npm run storybook:stop && cross-env STORYBOOK_ENABLED=true react-native start",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true ANDROID_HOME=%LOCALAPPDATA%/Android/Sdk ANDROID_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk react-native run-android",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true react-native run-ios",
    "storybook-generate": "sb-rn-get-stories",
    "test": "jest",
    "mail:test": "node scripts/testSmtpMail.js"
  },
