    "@storybook/addon-ondevice-controls": "^10.4.4",
    "@storybook/react-native": "^10.4.4",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/xlsx": "^0.0.35",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "storybook": "^10.4.0",
    "typescript": "^5.8.3"
  },
