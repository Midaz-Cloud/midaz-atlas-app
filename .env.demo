# Midaz-Web origin for ticket QR: {base}/track/{shortCode}. No trailing slash; do not append /track.
# Changing this requires a native rebuild (react-native-config does not hot-reload).
KIOSK_TRACK_BASE_URL=http://localhost:8001

# Opt-in Excel + SMTP after cierre de lote. Unset/false = skip (default).
# Changing this requires a native rebuild (react-native-config does not hot-reload).
KIOSK_SETTLEMENT_EXCEL_MAIL=false

