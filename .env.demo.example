# Copy to `.env.demo` for demo builds: npm run android:demo / ios:demo
# Requires a full native rebuild when values change.

KIOSK_DEMO_MODE=true
KIOSK_DEMO_REFERENCE_CODE=123456
KIOSK_DEMO_SCENARIO=default
KIOSK_DEMO_SHORT_TIMEOUTS=true

# true = config/catálogo mock (sin red). false = API live (misma URL/key que .env)
KIOSK_API_USE_MOCK=true

# Con KIOSK_API_USE_MOCK=false, definir también (copiar desde .env):
# KIOSK_API_BASE_URL=http://10.182.5.14:3000
# KIOSK_UPLOADS_BASE_URL=http://10.182.5.14:3000
# KIOSK_API_KEY=...
# KIOSK_DEVICE_SERIAL_OVERRIDE=AF910S202550915004

# KIOSK_DEMO_SCENARIO: default | fiscal_error | payment_fail | pos_fail

# Midaz-Web origin for ticket QR (`{base}/track/{shortCode}`). Origin only — no trailing slash.
# Empty falls back to http://localhost:8001 (documented placeholder; set this per environment).
# KIOSK_TRACK_BASE_URL=http://localhost:8001

# Opt-in Excel + SMTP after cierre de lote. Unset/false = skip (default).
# Changing this requires a native rebuild (react-native-config does not hot-reload).
KIOSK_SETTLEMENT_EXCEL_MAIL=false

# SMTP — cierre de lote por correo (opcional en demo). Used only when the flag above is true.
# KIOSK_MAIL_HOST=mail.example.com
# KIOSK_MAIL_PORT=465
# KIOSK_MAIL_USERNAME=noreply@example.com
# KIOSK_MAIL_PASSWORD=your-smtp-password
# KIOSK_MAIL_ENCRYPTION=ssl
# KIOSK_MAIL_FROM_ADDRESS=noreply@example.com
# KIOSK_MAIL_FROM_NAME="Panel Kiosco"
# KIOSK_MAIL_TO=ops@example.com
