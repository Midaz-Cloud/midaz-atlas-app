# Copy to `.env` for local builds (gitignored).
# Rebuild the native app after changing env values (not just JS reload).

KIOSK_DEMO_MODE=false

# Kiosk API (live local dev — set KIOSK_API_USE_MOCK=false)
KIOSK_API_USE_MOCK=true
KIOSK_API_BASE_URL=http://10.182.5.13:3000
KIOSK_API_KEY=your-kiosk-api-key-here
KIOSK_UPLOADS_BASE_URL=http://10.182.5.13:3000
# KIOSK_DEVICE_SERIAL_OVERRIDE=AF910-LOCAL-001

# Only used when KIOSK_DEMO_MODE=true (see .env.demo.example)
# KIOSK_DEMO_REFERENCE_CODE=123456
# KIOSK_DEMO_SCENARIO=default
# KIOSK_DEMO_SHORT_TIMEOUTS=false

# SMTP — cierre de lote por correo (Excel adjunto)
# KIOSK_MAIL_MAILER=smtp
# KIOSK_MAIL_HOST=mail.example.com
# KIOSK_MAIL_PORT=465
# KIOSK_MAIL_USERNAME=noreply@example.com
# KIOSK_MAIL_PASSWORD=your-smtp-password
# KIOSK_MAIL_ENCRYPTION=ssl
# KIOSK_MAIL_FROM_ADDRESS=noreply@example.com
# KIOSK_MAIL_FROM_NAME="Panel Kiosco"
# KIOSK_MAIL_TO=ops@example.com
